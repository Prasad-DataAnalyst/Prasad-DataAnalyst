~ A tour of the Tamas standard library. Every library is loaded with use("name").

~ --- semiconductor: how many good chips come off a wafer?
chip: use("semiconductor")
per_wafer: chip.dies_per_wafer(300 mm, 8 mm, 6 mm)
working: chip.yield_murphy(0.2 cm^-2, 8 mm * 6 mm)
show "Wafer: {per_wafer} dies, {round(working * 100, 1)}% yield, {floor(per_wafer * working)} good"
show "Thermal voltage at 85 C: {round(chip.thermal_voltage(358.15 K), 2)}"

~ --- robotics: where is the gripper, and how long does the move take?
robot: use("robotics")
tip: robot.forward([40 cm, 25 cm], [60 deg, -30 deg])
show "Gripper at x = {round(tip.x as cm, 1)}, y = {round(tip.y as cm, 1)}"
show "Move takes {round(robot.move_time(1.2 m, 0.8 m/s, 2 m/s^2), 2)}"

~ --- physics: an orbit 400 km above the Earth
space: use("physics")
orbit: space.earth_radius + 400 km
show "Orbit: {round(space.orbital_period(orbit, space.earth_mass) as min, 1)} at {round(space.orbital_speed(orbit, space.earth_mass) as km/s, 2)}"

~ --- finance: a home loan, in rupees
money: use("finance")
show "Monthly payment: {round(money.loan_payment(2500000 INR, 0.085, 180))}"

~ --- ai: learn from six examples, then classify a new one
ai: use("ai")
sizes: [[1.0, 1.1], [1.3, 0.9], [0.8, 1.2], [5.1, 4.8], [4.9, 5.3], [5.2, 5.0]]
kinds: ["small", "small", "small", "large", "large", "large"]
show "A [4.6, 4.4] part is {ai.knn(sizes, kinds, [4.6, 4.4], 3)}"

~ --- stats: a trend line through measurements that carry units
stats: use("stats")
trend: stats.linear_fit([1 h, 2 h, 3 h, 4 h], [52 km, 101 km, 149 km, 203 km])
show "Average speed: {round(trend.slope as km/h, 1)}, fit quality {round(trend.r2, 4)}"

~ --- xml, html, css: one document model for all of them. 'Single quotes' hold text exactly as written.
xml: use("xml")
order: xml.parse('<order id="A7"><item qty="2">Rice</item><item qty="5">Tea</item></order>')
show "Order {order.attrs.id}: {sum(map(xml.find(order, "item"), i -> number(i.attrs.qty)))} units"

html: use("html")
page: html.parse('<ul class="menu"><li><a href="/home">Home</a><li><a href="/docs">Docs</a></ul>')
show "Links:", map(html.select(page, "ul.menu a"), a -> a.attrs.href)
show html.write(html.el("p", {class: "total"}, ["Total: ", html.el("b", {}, "7 units")]))

css: use("css")
sheet: css.parse('.total { color: #063; font-weight: bold }')
sheet[0].declarations.color: "navy"
show css.write(sheet)
