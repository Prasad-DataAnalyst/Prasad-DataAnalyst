{
  "name": "tracewell",
  "version": "0.1.0",
  "description": "Tracewell Data Workbench: an offline, traceable data workbench for oil, gas and LNG data.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "Prasad (Prasad-DataAnalyst)"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:native": "cargo build --release --manifest-path crates/tracewell-engine/Cargo.toml",
    "test:native": "cargo test --release --manifest-path crates/tracewell-engine/Cargo.toml && npm run build:native",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:slow": "node scripts/test-all.mjs --slow",
    "fixtures": "python3 fixtures/generators/make_xlsx_fixtures.py && node fixtures/generators/gen-text-fixtures.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "check:licences": "node scripts/check-licences.mjs",
    "test": "node scripts/test-all.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@streamparser/json": "0.0.26",
    "@tanstack/react-virtual": "3.14.13",
    "fflate": "0.8.3",
    "hyparquet": "1.31.3",
    "hyparquet-writer": "0.16.11",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.2",
    "saxes": "6.0.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "papaparse": "5.7.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
